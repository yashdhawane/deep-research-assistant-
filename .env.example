# Model Provider Configuration
# Options: gemini, openai, ollama, llamacpp
MODEL_PROVIDER=gemini

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=gemini-2.5-flash
SUMMARIZATION_MODEL=gemini-2.5-flash

# OpenAI Configuration (if using OpenAI)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com
# MODEL_NAME=gpt-4-turbo

# Ollama Configuration (if using Ollama locally)
# OLLAMA_BASE_URL=http://localhost:11434
# MODEL_NAME=qwen2.5:7b

# Search Provider Configuration
# Options: duckduckgo (free), tavily (paid)
SEARCH_PROVIDER=duckduckgo
# TAVILY_API_KEY=your_tavily_api_key_here

# Research Configuration
MAX_SEARCH_QUERIES=5
MAX_SEARCH_RESULTS_PER_QUERY=5
MAX_REPORT_SECTIONS=10

# Citation Style
# Options: apa, mla, chicago, ieee
CITATION_STYLE=apa

# Chainlit Configuration
CHAINLIT_HOST=0.0.0.0
CHAINLIT_PORT=7860

# Caching
CACHE_TTL_DAYS=7
